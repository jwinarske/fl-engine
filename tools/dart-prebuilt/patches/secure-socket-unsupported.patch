 namespace dart {
 namespace bin {
 
+// fl-engine (tools/dart-prebuilt/patches): the natives dart:io calls between
+// connecting the plain socket and SecureSocket_Connect do nothing here, where
+// upstream has every one throw. _RawSecureSocket catches what Connect throws,
+// reports it through the future and closes the socket; an earlier throw is
+// outside that, and leaves the socket open with nothing holding it. Those are
+// SecurityContext_Allocate and _TrustBuiltinRoots (the default context), and
+// SecureSocket_Init, _RegisterHandshakeCompleteCallback,
+// _RegisterBadCertificateCallback, _RegisterKeyLogPort and _Destroy. No TLS
+// connection is made either way: Connect throws, as does everything that would
+// put a key or a certificate into a context.
+
 void FUNCTION_NAME(SecureSocket_Init)(Dart_NativeArguments args) {
-  Dart_ThrowException(DartUtils::NewDartArgumentError(
-      "Secure Sockets unsupported on this platform"));
 }
 
